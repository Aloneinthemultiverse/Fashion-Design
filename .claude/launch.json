{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streamlit",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "streamlit", "run", "src/fashion/ui/app.py", "--server.port", "8501", "--server.headless", "true"],
