# ---- Vision (VLM) ----------------------------------------------------------
# "fake" needs no key and is the default for tests/CI.
# "gemini" uses the Google AI Studio free tier: https://aistudio.google.com/apikey
FASHION_VISION_PROVIDER=fake
FASHION_GEMINI_API_KEY=
FASHION_GEMINI_MODEL=gemini-2.5-flash

# ---- Embeddings ------------------------------------------------------------
# "openclip" is verified working on CPU (~20s to load, ~0.3s/image, 512-dim) and is
# what you want for real use. The default stays "fake" so tests and CI need no
# 600MB download; it is hash-derived and semantically meaningless.
FASHION_EMBED_PROVIDER=fake          # fake | openclip
FASHION_CLIP_MODEL=ViT-B-32
FASHION_CLIP_PRETRAINED=laion2b_s34b_b79k

# ---- Vector store ----------------------------------------------------------
FASHION_STORE_PROVIDER=memory        # memory | qdrant
FASHION_QDRANT_URL=http://localhost:6333
FASHION_QDRANT_API_KEY=
FASHION_QDRANT_COLLECTION=outfits

# ---- Generation / try-on ---------------------------------------------------
# "null" degrades gracefully (side-by-side instead of try-on) and is the default.
FASHION_GENERATION_PROVIDER=null     # null | colab
FASHION_TRYON_PROVIDER=null          # null | colab
FASHION_COLAB_WORKER_URL=

# ---- Infrastructure --------------------------------------------------------
FASHION_REDIS_URL=redis://localhost:6379/0
FASHION_DATA_DIR=data/seed
FASHION_CACHE_DIR=data/cache
FASHION_LOG_LEVEL=INFO
